module

public import Mathlib.Algebra.BigOperators.Fin
public import Mathlib.Data.Finset.Card
public import Mathlib.Data.Finset.Union
public import Mathlib.Tactic.FinCases
public import Lean.Elab.Tactic.Omega

@[expose] public section

open Finset
open scoped BigOperators

namespace TranscendentalTuran.Green.Walks

/-- The vertices of the killed quadrant walk. -/
abbrev Point := ℕ × ℕ

/-- Four legal predecessors.  A missing predecessor means that the walk was killed
at the boundary.  The displacements are `±(1,0)` and `±(1,-1)`. -/
def predecessor (p : Point) (d : Fin 4) : Option Point :=
  match d.val with
  | 0 => some (p.1 + 1, p.2)
  | 1 => if p.1 = 0 then none else some (p.1 - 1, p.2)
  | 2 => if p.1 = 0 then none else some (p.1 - 1, p.2 + 1)
  | _ => if p.2 = 0 then none else some (p.1 + 1, p.2 - 1)

/-- A direction word is stored in reverse chronological order.  Its last visited
vertex is `p` and its first visited vertex is the corner. -/
def IsWalk : List (Fin 4) → Point → Prop
  | [], p => p = (0, 0)
  | d :: w, p => ∃ q, predecessor p d = some q ∧ IsWalk w q

/-- All legal length-`n` direction words from the corner to `p`. -/
def words : ℕ → Point → Finset (List (Fin 4))
  | 0, p => if p = (0, 0) then {[]} else ∅
  | n + 1, p => univ.biUnion fun d =>
      ((predecessor p d).elim ∅ (words n)).image (List.cons d)

/-- The ordinary natural-number walk kernel, generated by the four legal predecessor
choices.  Its interpretation as a finite cardinality is proved below. -/
def count : ℕ → Point → ℕ
  | 0, p => if p = (0, 0) then 1 else 0
  | n + 1, p => ∑ d : Fin 4, (predecessor p d).elim 0 (count n)

private theorem cons_images_disjoint (s t : Finset (List (Fin 4)))
    {d e : Fin 4} (hde : d ≠ e) :
    Disjoint (s.image (List.cons d)) (t.image (List.cons e)) := by
  apply Finset.disjoint_left.mpr
  intro w hw₁ hw₂
  obtain ⟨u, _, rfl⟩ := Finset.mem_image.mp hw₁
  obtain ⟨v, _, hv⟩ := Finset.mem_image.mp hw₂
  exact hde (List.cons.inj hv).1.symm

/-- The kernel counts actual legal direction words, rather than a sequence introduced
by an arithmetic formula. -/
theorem card_words (n : ℕ) (p : Point) : (words n p).card = count n p := by
  induction n generalizing p with
  | zero =>
      by_cases hp : p = (0, 0) <;> simp [words, count, hp]
  | succ n ih =>
      rw [words, Finset.card_biUnion]
      · unfold count
        apply Finset.sum_congr rfl
        intro d _
        rw [Finset.card_image_of_injective _ (fun _ _ h => (List.cons.inj h).2)]
        cases h : predecessor p d with
        | none => simp [h]
        | some q => simpa [h] using ih q
      · intro d _ e _ hde
        exact cons_images_disjoint _ _ hde

/-- The finite set is exactly the words with the advertised length and legal steps. -/
theorem mem_words (n : ℕ) (p : Point) (w : List (Fin 4)) :
    w ∈ words n p ↔ w.length = n ∧ IsWalk w p := by
  induction n generalizing p w with
  | zero =>
      by_cases hp : p = (0, 0) <;> cases w <;> simp [words, IsWalk, hp]
  | succ n ih =>
      cases w with
      | nil => simp [words, IsWalk]
      | cons d w =>
          simp only [words, Finset.mem_biUnion, Finset.mem_univ, true_and,
            Finset.mem_image, List.cons.injEq, List.length_cons, Nat.add_right_cancel_iff,
            IsWalk]
          constructor
          · rintro ⟨e, v, hv, hcons⟩
            obtain ⟨he, hv'⟩ := hcons
            subst e
            subst v
            cases h : predecessor p d with
            | none => simp [h] at hv
            | some q =>
                have hw := (ih q w).1 (by simpa [h] using hv)
                exact ⟨hw.1, q, rfl, hw.2⟩
          · rintro ⟨hwlen, q, hq, hw⟩
            exact ⟨d, w, by simpa [hq] using (ih q w).2 ⟨hwlen, hw⟩, rfl, rfl⟩

@[simp] theorem count_zero (i j : ℕ) :
    count 0 (i, j) = if i = 0 ∧ j = 0 then 1 else 0 := by
  simp [count, Prod.mk.injEq]

/-- The explicit four-step recurrence, with every missing boundary step killed. -/
theorem count_succ (n i j : ℕ) :
    count (n + 1) (i, j) =
      count n (i + 1, j) + (if i = 0 then 0 else count n (i - 1, j)) +
      (if i = 0 then 0 else count n (i - 1, j + 1)) +
      (if j = 0 then 0 else count n (i + 1, j - 1)) := by
  by_cases hi : i = 0 <;> by_cases hj : j = 0 <;>
    simp [count, Fin.sum_univ_succ, predecessor, hi, hj, Nat.add_assoc]

end TranscendentalTuran.Green.Walks
